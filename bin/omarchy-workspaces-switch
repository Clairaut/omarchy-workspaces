#!/bin/bash

# omarchy-workspaces-switch: non-interactive backend for the zone-switcher Panel.qml.
# Usage: omarchy-workspaces-switch --switch-slot N | --move-slot N
# State: ~/.local/state/omarchy/workspaces/zones.json (owned by Panel.qml -- this script only reads it).

set -euo pipefail

STATE_DIR="$HOME/.local/state/omarchy/workspaces"
STATE_FILE="$STATE_DIR/zones.json"

mkdir -p "$STATE_DIR"
[[ -f "$STATE_FILE" ]] || printf '{"zones":[],"lastWorkspace":{}}' >"$STATE_FILE"

notify() {
  notify-send "Workspace zones" "$1"
}

sorted_monitor_names() {
  hyprctl monitors -j | jq -r 'sort_by(.x) | .[].name'
}

monitor_active_workspace() {
  hyprctl monitors -j | jq -r --arg m "$1" '.[] | select(.name == $m) | .activeWorkspace.id'
}

focused_monitor_name() {
  hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .name'
}

# Records each monitor's current workspace under whichever slot it's actually in right now.
remember_current_workspaces() {
  local state
  state=$(jq -c '.lastWorkspace' "$STATE_FILE")

  local -a monitor_names
  mapfile -t monitor_names <<<"$(sorted_monitor_names)"

  local m active slot
  for m in "${monitor_names[@]}"; do
    active=$(monitor_active_workspace "$m")
    [[ -n $active && $active != null ]] || continue
    slot=$(( (active - 1) / 20 + 1 ))
    state=$(jq --arg slot "$slot" --arg m "$m" --argjson ws "$active" \
      '.[$slot][$m] = $ws' <<<"$state")
  done

  jq --argjson lw "$state" '.lastWorkspace = $lw' "$STATE_FILE" >"$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

switch_to_slot() {
  local slot="$1"
  local zone_base=$(( (slot - 1) * 20 ))

  remember_current_workspaces

  local -a monitor_names
  mapfile -t monitor_names <<<"$(sorted_monitor_names)"

  local i=0 m target remembered
  for m in "${monitor_names[@]}"; do
    remembered=$(jq -r --arg slot "$slot" --arg m "$m" '.lastWorkspace[$slot][$m] // empty' "$STATE_FILE")
    if [[ -n $remembered ]]; then
      target="$remembered"
    else
      target=$(( zone_base + i * 10 + 1 ))
    fi
    local result
    result=$(hyprctl eval "hl.get_monitor(\"$m\"):set_workspace({ workspace = \"$target\" })")
    [[ $result == ok ]] || notify "Failed to switch $m to workspace $target: $result"
    i=$((i + 1))
  done
}

# Like switch_to_slot, but the focused window's own monitor moves via window.move (which
# follows), carrying the window along; other monitors just switch, same as switch_to_slot.
move_window_to_slot() {
  local slot="$1"
  local zone_base=$(( (slot - 1) * 20 ))
  local focused
  focused=$(focused_monitor_name)

  remember_current_workspaces

  local -a monitor_names
  mapfile -t monitor_names <<<"$(sorted_monitor_names)"

  local i=0 m target remembered
  for m in "${monitor_names[@]}"; do
    if [[ $m == "$focused" ]]; then
      local local_pos active
      active=$(monitor_active_workspace "$m")
      local_pos=$(( (active - 1) % 10 + 1 ))
      target=$(( zone_base + i * 10 + local_pos ))
      local result
      result=$(hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = \"$target\" }))")
      [[ $result == ok ]] || notify "Failed to move window to workspace $target: $result"
    else
      remembered=$(jq -r --arg slot "$slot" --arg m "$m" '.lastWorkspace[$slot][$m] // empty' "$STATE_FILE")
      if [[ -n $remembered ]]; then
        target="$remembered"
      else
        target=$(( zone_base + i * 10 + 1 ))
      fi
      local result
      result=$(hyprctl eval "hl.get_monitor(\"$m\"):set_workspace({ workspace = \"$target\" })")
      [[ $result == ok ]] || notify "Failed to switch $m to workspace $target: $result"
    fi
    i=$((i + 1))
  done
}

case "${1:-}" in
  --switch-slot)
    switch_to_slot "$2"
    ;;
  --move-slot)
    move_window_to_slot "$2"
    ;;
  *)
    echo "Usage: omarchy-workspaces-switch --switch-slot N | --move-slot N" >&2
    exit 1
    ;;
esac
