#!/bin/bash

# omarchy-workspaces-switch: SUPER+E picker for named, creatable workspace environments (see hypr/workspaces.lua for the pinning scheme).
# State: ~/.local/state/omarchy/workspaces/environments.json. Requires omarchy-menu-select, omarchy-menu-input, jq.

set -euo pipefail

CAP=10
STATE_DIR="$HOME/.local/state/omarchy/workspaces"
STATE_FILE="$STATE_DIR/environments.json"
CREATE_LABEL="Create new environment"
CREATE_ICON=$''   # nf-fa-plus

mkdir -p "$STATE_DIR"
[[ -f "$STATE_FILE" ]] || printf '{"environments":[],"lastWorkspace":{}}' >"$STATE_FILE"

notify() {
  notify-send "Workspace environments" "$1"
}

sorted_monitor_names() {
  hyprctl monitors -j | jq -r 'sort_by(.x) | .[].name'
}

monitor_active_workspace() {
  hyprctl monitors -j | jq -r --arg m "$1" '.[] | select(.name == $m) | .activeWorkspace.id'
}

# Records each monitor's current workspace under whichever slot it's actually in right now.
remember_current_workspaces() {
  local state
  state=$(jq -c '.lastWorkspace' "$STATE_FILE")

  local -a monitor_names
  mapfile -t monitor_names <<<"$(sorted_monitor_names)"

  local m active slot
  for m in "${monitor_names[@]}"; do
    active=$(monitor_active_workspace "$m")
    [[ -n $active && $active != null ]] || continue
    slot=$(( (active - 1) / 20 + 1 ))
    state=$(jq --arg slot "$slot" --arg m "$m" --argjson ws "$active" \
      '.[$slot][$m] = $ws' <<<"$state")
  done

  jq --argjson lw "$state" '.lastWorkspace = $lw' "$STATE_FILE" >"$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
}

switch_to_slot() {
  local slot="$1"
  local env_base=$(( (slot - 1) * 20 ))

  remember_current_workspaces

  local -a monitor_names
  mapfile -t monitor_names <<<"$(sorted_monitor_names)"

  local i=0 m target remembered
  for m in "${monitor_names[@]}"; do
    remembered=$(jq -r --arg slot "$slot" --arg m "$m" '.lastWorkspace[$slot][$m] // empty' "$STATE_FILE")
    if [[ -n $remembered ]]; then
      target="$remembered"
    else
      target=$(( env_base + i * 10 + 1 ))
    fi
    local result
    result=$(hyprctl eval "hl.get_monitor(\"$m\"):set_workspace({ workspace = \"$target\" })")
    [[ $result == ok ]] || notify "Failed to switch $m to workspace $target: $result"
    i=$((i + 1))
  done
}

create_environment() {
  local envs_json count
  envs_json=$(jq -c '.environments' "$STATE_FILE")
  count=$(jq 'length' <<<"$envs_json")

  if (( count >= CAP )); then
    notify "Max of $CAP environments reached"
    exit 1
  fi

  local name
  name=$(omarchy-menu-input "Environment name") || exit 0
  [[ -n $name ]] || exit 0

  if jq -e --arg n "$name" 'any(.[]; .name == $n)' <<<"$envs_json" >/dev/null; then
    notify "\"$name\" already exists"
    exit 1
  fi

  local icon_options=(
    $'\tPerson'
    $'\tBriefcase'
    $'\tHouse'
    $'\tGame controller'
    $'\tCode'
    $'\tGlobe'
    $'\tCustom glyph...'
  )
  local icon_choice icon
  icon_choice=$(omarchy-menu-select "Icon for $name" "${icon_options[@]}") || exit 0

  case "$icon_choice" in
    Person) icon=$'' ;;
    Briefcase) icon=$'' ;;
    House) icon=$'' ;;
    "Game controller") icon=$'' ;;
    Code) icon=$'' ;;
    Globe) icon=$'' ;;
    "Custom glyph...")
      icon=$(omarchy-menu-input "Icon glyph") || exit 0
      [[ -n $icon ]] || icon=$''   # nf-fa-cog fallback
      ;;
    *) exit 0 ;;
  esac

  # First unused slot in 1..CAP.
  local used_slots slot
  used_slots=$(jq -c '[.[].slot]' <<<"$envs_json")
  slot=$(jq -n --argjson used "$used_slots" --argjson cap "$CAP" \
    '([range(1; $cap + 1)] - $used) | first')

  jq --arg name "$name" --arg icon "$icon" --argjson slot "$slot" \
    '.environments += [{slot: $slot, name: $name, icon: $icon}]' \
    "$STATE_FILE" >"$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"

  switch_to_slot "$slot"
}

main() {
  local envs_json options selection slot
  envs_json=$(jq -c '.environments' "$STATE_FILE")

  local envs_options
  envs_options=$(jq -r '.[] | "\(.icon)\t\(.name)"' <<<"$envs_json")
  if [[ -n $envs_options ]]; then
    mapfile -t options <<<"$envs_options"
  else
    options=()
  fi
  options+=("$CREATE_ICON"$'\t'"$CREATE_LABEL")

  selection=$(omarchy-menu-select "Switch environment" "${options[@]}") || exit 0

  if [[ $selection == "$CREATE_LABEL" ]]; then
    create_environment
    return
  fi

  slot=$(jq -r --arg n "$selection" '.[] | select(.name == $n) | .slot' <<<"$envs_json")
  if [[ -z $slot ]]; then
    notify "Unknown environment: $selection"
    exit 1
  fi

  switch_to_slot "$slot"
}

main
